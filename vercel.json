{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-vercel.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sign-in/:path*", "destination": "/index.html" },
    { "source": "/sign-up/:path*", "destination": "/index.html" }
  ]
}
